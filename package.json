{
  "scripts": {
    "up": "pnpm recreate && pnpm sync-data",
    "recreate": "docker compose -f ./docker-compose.yml -f ./docker-compose.local.yml --profile mock-services up -d --quiet-pull --build --renew-anon-volumes --force-recreate",
    "restart": "pnpm stop && pnpm start",
    "start": "docker compose -f ./docker-compose.yml -f ./docker-compose.local.yml --profile mock-services up -d --quiet-pull",
    "stop": "./scripts/stop-containers.sh",
    "down": "pnpm destroy",
    "destroy": "./scripts/destroy-containers.sh",
    "sync-data": "docker compose -f ./docker-compose.yml -f ./docker-compose.local.yml -f ./docker-compose.seed.yml run seed-database",
    "test-sync": "docker compose -f ./docker-compose.yml -f ./docker-compose.local.yml -f ./docker-compose.seed.yml run seed-database reset_flows",
    "clean-data": "docker compose -f ./docker-compose.yml -f ./docker-compose.seed.yml run seed-database reset_all",
    "dev": "./scripts/start-containers-for-dev.sh",
    "tests": "./scripts/start-containers-for-tests.sh",
    "analytics": "docker compose -f ./docker-compose.yml -f ./docker-compose.local.yml --profile mock-services --profile analytics  up -d --quiet-pull",
    "logs": "docker compose logs --tail 30 -f",
    "build": "turbo run build",
    "check": "turbo run typecheck lint",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "watch:packages": "turbo watch build --filter=\"./packages/*\"",
    "preanalytics": "./scripts/build-packages.sh",
    "prebuild": "./scripts/check-containers.sh dev",
    "prerecreate": "./scripts/build-packages.sh",
    "prepare": "husky",
    "prestart": "./scripts/build-packages.sh",
    "pretest": "./scripts/check-containers.sh e2e",
    "postinstall": "if [ -f ./scripts/build-packages.sh ]; then ./scripts/build-packages.sh; fi"
  },
  "lint-staged": {
    "apps/editor.planx.uk/src/**/*.{js,jsx,ts,tsx}": "eslint --fix --flag v10_config_lookup_from_file",
    "apps/api.planx.uk/**/*.{js,ts}": "eslint --fix --flag v10_config_lookup_from_file",
    "apps/hasura.planx.uk/tests/**/*.js": "eslint --fix --flag v10_config_lookup_from_file",
    "apps/tests/**/*.{js,ts}": "eslint --fix --flag v10_config_lookup_from_file",
    "e2e/tests/**/*.{js,ts}": "eslint --fix --flag v10_config_lookup_from_file",
    "apps/localplanning.services/**/*.{js,jsx,ts,tsx,mjs}": "eslint --fix --flag v10_config_lookup_from_file",
    "packages/file-upload/**/*.ts": "eslint --fix --flag v10_config_lookup_from_file",
    "infrastructure/**/*.{js,ts}": "eslint --fix --flag v10_config_lookup_from_file",
    "packages/eslint-config/*.js": "eslint --fix --flag v10_config_lookup_from_file",
    "{apps/editor.planx.uk/src,apps/api.planx.uk,apps/localplanning.services,e2e/tests,apps/hasura.planx.uk/tests,packages/file-upload,infrastructure,packages/eslint-config}/**/*.{js,jsx,ts,tsx,json,css,scss,md,html}": "prettier --write"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:typescript"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "nock": "13"
      },
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    },
    "onlyBuiltDependencies": [
      "@kirillvakalov/hasura-cli",
      "@opensystemslab/planx-core",
      "@parcel/watcher",
      "@pulumi/aws",
      "@pulumi/cloudflare",
      "@pulumi/docker",
      "@pulumi/docker-build",
      "@swc/core",
      "aws-sdk",
      "core-js",
      "esbuild",
      "preact",
      "protobufjs",
      "tldjs"
    ],
    "ignoredBuiltDependencies": [
      "msw"
    ],
    "overrides": {
      "body-parser@<1.20.9": ">=1.20.9",
      "fast-uri@<3.1.9": ">=3.1.9",
      "fast-uri@<4.0.0": ">=4.2.3",
      "compression@<1.8.2": ">=1.8.2"
    }
  }
}
