{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "!build/storybook/**"],
      "env": ["VITE_*"]
    },
    "storybook:build": {
      "dependsOn": ["build"],
      "outputs": ["build/storybook/**"],
      "env": ["VITE_*"]
    },
    "storybook:dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
