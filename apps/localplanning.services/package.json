{
  "name": "localplanning.services",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build --mode ${BUILD_MODE:-dev}",
    "check": "pnpm typecheck",
    "dev": "astro dev --mode dev --open",
    "lint": "eslint . && prettier -c . --ignore-path ../../.prettierignore",
    "lint:fix": "eslint --fix . && prettier -w . --ignore-path ../../.prettierignore",
    "preview": "astro preview --open",
    "storybook": "storybook dev -p 6006",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@nanostores/react": "^1.1.0",
    "@opensystemslab/map": "catalog:",
    "@planx/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.9",
    "astro-icon": "^1.2.0",
    "astro-seo": "^1.1.0",
    "graphql": "catalog:graphql",
    "graphql-tag": "catalog:graphql",
    "nanostores": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwind-clamp": "^4.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:typescript"
  },
  "devDependencies": {
    "@planx/eslint-config": "workspace:*",
    "@planx/prettier-config": "workspace:*",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "storybook": "^10.5.10",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.2.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "prettier": "@planx/prettier-config"
}
